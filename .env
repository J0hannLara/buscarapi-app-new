# 🌍 Configuración de entornos

# 👉 Ambiente en el que está corriendo la app
ENV=dev

# 👉 Servidores según el entorno
BASE_URL_DEV=https://buscarapi.onrender.com
BASE_URL_STAGING=https://buscarapi.onrender.com
BASE_URL_PROD=https://buscarapi.onrender.com
BASE_URL=https://buscarapi.onrender.com
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png


# 👉 Claves opcionales (ejemplo si usas APIs externas)
MAPS_API_KEY=tu_api_key_de_google_maps
SENTRY_DSN=tu_dsn_para_error_tracking
